@model IEnumerable<SupportPanel.Models.Tenant>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title mb-0">Firmalar</h2>
    <a asp-action="Create" class="btn btn-primary">Yeni Firma</a>
</div>

<div class="card">
    <div class="card-body">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="text-uppercase text-muted small">Firma</th>
                    <th class="text-uppercase text-muted small">İletişim</th>
                    <th class="text-uppercase text-muted small">E-posta</th>
                    <th class="text-uppercase text-muted small">Telefon</th>
                    <th class="text-uppercase text-muted small">Durum</th>
                    <th class="text-uppercase text-muted small">İşlemler</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.CompanyName</td>
                        <td>@item.ContactName</td>
                        <td>@item.Email</td>
                        <td>@item.Phone</td>

                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Pasif</span>
                            }
                        </td>

                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-warning btn-sm">
                                Düzenle
                            </a>

                            @if (item.IsActive)
                            {
                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-danger btn-sm">
                                    Pasifleştir
                                </a>
                            }
                            else
                            {
                                <form asp-action="Reactivate"
                                      method="post"
                                      class="d-inline">
                                    <input type="hidden"
                                           name="id"
                                           value="@item.Id" />
                                    <button type="submit" class="btn btn-success btn-sm">
                                        Aktifleştir
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
