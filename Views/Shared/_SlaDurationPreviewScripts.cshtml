<script>
    (function () {
        function formatMinutes(totalMinutes) {
            var value = Number.parseInt(totalMinutes, 10);

            if (!Number.isFinite(value) || value <= 0) {
                return "";
            }

            var days = Math.floor(value / 1440);
            var remainingAfterDays = value % 1440;
            var hours = Math.floor(remainingAfterDays / 60);
            var minutes = remainingAfterDays % 60;
            var parts = [];

            if (days > 0) parts.push(days + " gün");
            if (hours > 0) parts.push(hours + " saat");
            if (minutes > 0) parts.push(minutes + " dakika");

            return parts.join(" ");
        }

        document.querySelectorAll(".sla-minute-input").forEach(function (input) {
            var preview = input.parentElement.querySelector(".sla-duration-preview");

            function updatePreview() {
                var formatted = formatMinutes(input.value);
                preview.textContent = formatted ? "Karşılığı: " + formatted : "";
            }

            input.addEventListener("input", updatePreview);
            updatePreview();
        });
    })();
</script>
