@using SupportPanel.Constants
@model SupportPanel.Models.Ticket
@{
    var slaTracking = ViewBag.SlaTracking as SlaTrackingResult;
}

<div class="ticket-back-action mb-3">
    @if (ViewBag.ReturnToMyTickets == true)
    {
        <a asp-action="MyTickets" class="btn btn-primary btn-sm px-3 fw-semibold shadow-sm">
            &larr; Geri
        </a>
    }
    else if (ViewBag.ReturnToSupportPool == true)
    {
        <a asp-action="SupportPool" class="btn btn-primary btn-sm px-3 fw-semibold shadow-sm">
            &larr; Geri
        </a>
    }
    else if (ViewBag.ReturnToCompanyTickets == true)
    {
        <a asp-action="CompanyTickets" class="btn btn-primary btn-sm px-3 fw-semibold shadow-sm">
            &larr; Geri
        </a>
    }
    else
    {
        <a asp-action="Index" class="btn btn-primary btn-sm px-3 fw-semibold shadow-sm">
            &larr; Geri
        </a>
    }
</div>

<div class="d-flex align-items-center flex-wrap gap-2 mb-4">
    <h4 class="page-title mb-0">@Model.Title</h4>
    @await Html.PartialAsync("_StatusBadge", Model.Status)
    @await Html.PartialAsync("_PriorityBadge", Model.Priority)
    <span class="badge bg-light text-dark">SLA: @Model.SlaLevel?.Name</span>
</div>

<div class="row">

    <div class="col-lg-8">

        <ul class="nav nav-tabs" id="ticketTabs" role="tablist">

            <li class="nav-item" role="presentation">
                <button class="nav-link active"
                        id="ticket-detail-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#ticket-detail"
                        type="button"
                        role="tab"
                        aria-controls="ticket-detail"
                        aria-selected="true">
                    Genel Bilgiler
                </button>
            </li>

            <li class="nav-item" role="presentation">
                <button class="nav-link"
                        id="ticket-files-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#ticket-files"
                        type="button"
                        role="tab"
                        aria-controls="ticket-files"
                        aria-selected="false">
                    Dosyalar (@(((List<SupportPanel.Models.TicketAttachment>)ViewBag.Attachments).Count))
                </button>
            </li>

            <li class="nav-item" role="presentation">
                <button class="nav-link"
                        id="ticket-history-tab"
                        data-bs-toggle="tab"
                        data-bs-target="#ticket-history"
                        type="button"
                        role="tab"
                        aria-controls="ticket-history"
                        aria-selected="false">
                    Aktivite Geçmişi (@(((List<SupportPanel.Models.TicketHistory>)ViewBag.History).Count))
                </button>
            </li>

        </ul>

        <div class="tab-content pt-3">

            <div class="tab-pane fade show active"
                 id="ticket-detail"
                 role="tabpanel"
                 aria-labelledby="ticket-detail-tab">

                <dl class="row">

                    <dt class="col-sm-3">Firma</dt>
                    <dd class="col-sm-9">@Model.Tenant?.CompanyName</dd>

                    <dt class="col-sm-3">Ürün</dt>
                    <dd class="col-sm-9">@Model.Product?.Name</dd>

                    <dt class="col-sm-3">Kategori</dt>
                    <dd class="col-sm-9">@Model.Category?.Name</dd>

                    <dt class="col-sm-3">Öncelik</dt>
                    <dd class="col-sm-9">@await Html.PartialAsync("_PriorityBadge", Model.Priority)</dd>

                    <dt class="col-sm-3">SLA</dt>
                    <dd class="col-sm-9">@Model.SlaLevel?.Name</dd>

                    <dt class="col-sm-3">Durum</dt>
                    <dd class="col-sm-9">@await Html.PartialAsync("_StatusBadge", Model.Status)</dd>

                    <dt class="col-sm-3">Oluşturan</dt>
                    <dd class="col-sm-9">
                        @Model.CreatedByUser?.FirstName
                        @Model.CreatedByUser?.LastName
                    </dd>

                    <dt class="col-sm-3">Atanan</dt>
                    <dd class="col-sm-9">
                        @if (Model.AssignedUser != null)
                        {
                            @Model.AssignedUser.FirstName
                            @Model.AssignedUser.LastName
                        }
                        else
                        {
                            <span class="text-muted">Atanmadı</span>
                        }
                    </dd>

                    <dt class="col-sm-3">Oluşturulma Tarihi</dt>
                    <dd class="col-sm-9">
                        @Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                    </dd>

                    @if (Model.Status == TicketStatus.Cancelled)
                    {
                        <dt class="col-sm-3">İptal Tarihi</dt>
                        <dd class="col-sm-9">
                            @Model.CancelledDate?.ToString("dd.MM.yyyy HH:mm")
                        </dd>
                    }

                    <dt class="col-sm-3">Açıklama</dt>
                    <dd class="col-sm-9">
                        <div class="border rounded p-3 bg-white">
                            @Model.Description
                        </div>
                    </dd>

                </dl>

            <div class="mt-4 pt-3 border-top">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">Talep Yazışmaları</h5>
                    <span class="badge bg-light text-dark">
                        @(((List<SupportPanel.Models.TicketComment>)ViewBag.Comments).Count) mesaj
                    </span>
                </div>

                @if (((List<SupportPanel.Models.TicketComment>)ViewBag.Comments).Any())
                {
                    foreach (var comment in (List<SupportPanel.Models.TicketComment>)ViewBag.Comments)
                    {
                        <div class="card mb-3">
                            <div class="card-body">
                                <div class="d-flex align-items-start gap-3">
                                    <span class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center fw-semibold"
                                          style="width: 36px; height: 36px;">
                                        @(comment.User?.FirstName?.Substring(0, 1) ?? "?")@(comment.User?.LastName?.Substring(0, 1) ?? "")
                                    </span>
                                    <div class="w-100">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="fw-semibold">
                                                @comment.User?.FirstName
                                                @comment.User?.LastName
                                            </span>
                                            <small class="text-muted">
                                                @comment.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                                            </small>
                                        </div>
                                        <p class="mb-0 mt-2">
                                            @comment.Message
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-light text-muted">
                        Henüz mesaj bulunmuyor.
                    </div>
                }

                @if (Model.Status != TicketStatus.Cancelled && Model.Status != TicketStatus.Closed && ViewBag.CanModifyTicket != false)
                {
                    <div class="card mt-3 mb-5">
                        <div class="card-header">
                            <strong>Mesaj Yaz</strong>
                        </div>
                        <div class="card-body">

                            <form asp-action="AddComment" method="post" novalidate>

                                <input type="hidden"
                                       name="TicketId"
                                       value="@Model.Id" />

                                <div class="mb-3">
                                    <textarea name="Message"
                                              class="form-control"
                                              rows="3"
                                              data-val="true"
                                              placeholder="Talep ile ilgili mesajınızı yazın..."
                                              data-val-required="Mesaj boş olamaz."
                                              data-val-length="Mesaj en az 2 karakter olmalıdır."
                                              data-val-length-min="2"
                                              data-val-length-max="2000"></textarea>
                                    <span class="field-validation-valid text-danger"
                                          data-valmsg-for="Message"
                                          data-valmsg-replace="true"></span>
                                </div>

                                <button type="submit"
                                        class="btn btn-primary">
                                    Mesaj Gönder
                                </button>

                            </form>

                        </div>
                    </div>
                }

            </div>

            </div>

            <div class="tab-pane fade"
                 id="ticket-files"
                 role="tabpanel"
                 aria-labelledby="ticket-files-tab">

                @if (((List<SupportPanel.Models.TicketAttachment>)ViewBag.Attachments).Any())
                {
                    foreach (var attachment in (List<SupportPanel.Models.TicketAttachment>)ViewBag.Attachments)
                    {
                        <div class="card mb-2">
                            <div class="card-body d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">@attachment.FileName</div>
                                    <small class="text-muted">
                                        Yükleyen:
                                        @attachment.UploadedByUser?.FirstName
                                        @attachment.UploadedByUser?.LastName
                                        &nbsp;|&nbsp;
                                        @attachment.UploadedDate.ToString("dd.MM.yyyy HH:mm")
                                    </small>
                                </div>
                                <a asp-controller="Ticket"
                                   asp-action="DownloadAttachment"
                                   asp-route-ticketId="@Model.Id"
                                   asp-route-attachmentId="@attachment.Id"
                                   class="btn btn-outline-primary btn-sm">
                                    Dosyayı İndir
                                </a>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-light text-muted">
                        Henüz dosya yüklenmemiş.
                    </div>
                }

                @if (Model.Status != TicketStatus.Cancelled && Model.Status != TicketStatus.Closed && ViewBag.CanModifyTicket != false)
                {
                    <div class="card mt-3">
                        <div class="card-header">
                            <strong>Dosya Yükle</strong>
                        </div>
                        <div class="card-body">

                            @if (TempData["UploadError"] != null)
                            {
                                <div class="alert alert-danger">@TempData["UploadError"]</div>
                            }

                            @if (TempData["UploadSuccess"] != null)
                            {
                                <div class="alert alert-success">@TempData["UploadSuccess"]</div>
                            }

                            <form asp-action="UploadAttachment"
                                  method="post"
                                  enctype="multipart/form-data"
                                  novalidate>

                                <input type="hidden"
                                       name="TicketId"
                                       value="@Model.Id" />

                                <div class="mb-3">
                                    <input type="file"
                                           name="File"
                                           id="detailsFileInput"
                                           class="form-control" />
                                    <div class="form-text text-muted">En fazla 20 MB. İzin verilen türler: jpg, jpeg, png, gif, webp, pdf, doc, docx, xls, xlsx, txt, zip, log</div>
                                </div>

                                <button type="submit"
                                        class="btn btn-primary">
                                    Dosya Yükle
                                </button>

                            </form>

                        </div>
                    </div>
                }

            </div>

            <div class="tab-pane fade"
                 id="ticket-history"
                 role="tabpanel"
                 aria-labelledby="ticket-history-tab">

                @if (((List<SupportPanel.Models.TicketHistory>)ViewBag.History).Any())
                {
                    <table class="table table-sm table-hover">

                        <thead>
                            <tr>
                                <th>Tarih</th>
                                <th>Kullanıcı</th>
                                <th>İşlem</th>
                                <th>Eski Değer</th>
                                <th>Yeni Değer</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var history in (List<SupportPanel.Models.TicketHistory>)ViewBag.History)
                            {
                                <tr>

                                    <td>
                                        @history.ActionDate.ToString("dd.MM.yyyy HH:mm")
                                    </td>

                                    <td>
                                        @history.User?.FirstName
                                        @history.User?.LastName
                                    </td>

                                    <td>
                                        <span class="badge bg-light text-dark">@history.Action</span>
                                    </td>

                                    <td>
                                        @(history.OldValue ?? "-")
                                    </td>

                                    <td>
                                        @(history.NewValue ?? "-")
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>
                }
                else
                {
                    <div class="alert alert-light text-muted">
                        Henüz aktivite kaydı bulunmuyor.
                    </div>
                }

            </div>

        </div>

    </div>

    <div class="col-lg-4">

        <div class="sticky-top" style="top: 1rem;">

            <div class="card mb-3">
                <div class="card-header">
                    <strong>Durum Yönetimi</strong>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span>Mevcut Durum</span>
                        @await Html.PartialAsync("_StatusBadge", Model.Status)
                    </div>

                    @if (Model.Status == TicketStatus.Cancelled)
                    {
                        <div class="alert alert-warning mb-3">
                            Bu talep iptal edilmiştir. Güncelleme yapılamaz.
                        </div>

                        @if (Model.CancelledDate.HasValue)
                        {
                            <p class="text-muted mb-0">
                                İptal Tarihi: @Model.CancelledDate.Value.ToString("dd.MM.yyyy HH:mm")
                            </p>
                        }
                    }
                    else if (Model.Status == TicketStatus.Closed)
                    {
                        <div class="alert alert-secondary mb-3">
                            Bu talep kapatılmıştır. Müşteri onayıyla yeniden açılabilir.
                        </div>
                    }
                    else if (User.IsInRole(RoleNames.CompanyManager))
                    {
                        @if (ViewBag.CanCompanyRoute == true)
                        {
                            <form asp-action="ChangeStatus" method="post" class="mb-2">
                                <input type="hidden" name="ticketId" value="@Model.Id" />
                                <input type="hidden" name="status" value="@TicketStatus.SupportQueue" />
                                <button class="btn btn-primary w-100" type="submit">Desteğe Yönlendir</button>
                            </form>
                        }

                        @if (ViewBag.CanCompanyClose == true)
                        {
                            <form asp-action="ChangeStatus" method="post" id="companyCloseForm">
                                <input type="hidden" name="ticketId" value="@Model.Id" />
                                <input type="hidden" name="status" value="@TicketStatus.Closed" />
                                <button class="btn btn-success w-100" type="button"
                                        data-bs-toggle="modal" data-bs-target="#companyCloseModal">
                                    @(Model.Status == TicketStatus.New ? "Firma İçinde Çöz ve Kapat" : "Talebi Kapat")
                                </button>
                            </form>

                        }
                    }
                    else if ((User.IsInRole(RoleNames.SystemAdmin) || User.IsInRole(RoleNames.SupportSpecialist) || User.IsInRole(RoleNames.ProductManager)) && ViewBag.CanModifyTicket != false && ((List<KeyValuePair<string, string>>)ViewBag.AllowedStatuses).Count > 0)
                    {
                        <form asp-action="ChangeStatus"
                              method="post"
                              novalidate>

                            <input type="hidden"
                                   name="ticketId"
                                   value="@Model.Id" />

                            <label class="form-label small text-muted mb-1">Yeni Durum</label>
                            <select name="status" class="form-select mb-2">
                                @foreach (var kvp in (List<KeyValuePair<string, string>>)ViewBag.AllowedStatuses)
                                {
                                    <option value="@kvp.Key">@kvp.Value</option>
                                }
                            </select>

                            <button class="btn btn-primary w-100"
                                    type="submit">
                                Uygula
                            </button>

                        </form>
                    }

                    @if (ViewBag.CanReopen == true)
                    {
                        <form asp-action="Reopen"
                              id="reopenTicketForm"
                              method="post">
                            <input type="hidden" name="ticketId" value="@Model.Id" />
                            <button class="btn btn-primary w-100 mt-2"
                                    type="button"
                                    data-bs-toggle="modal"
                                    data-bs-target="#reopenTicketModal">
                                Yeniden Aç
                            </button>
                        </form>
                    }

                    @if (ViewBag.CanCancel == true)
                    {
                        <form asp-action="Cancel"
                              id="cancelTicketForm"
                              method="post"
                              novalidate>

                            <input type="hidden"
                                   name="ticketId"
                                   value="@Model.Id" />

                            <button class="btn btn-outline-danger w-100 mt-2"
                                    type="button"
                                    data-bs-toggle="modal"
                                    data-bs-target="#cancelTicketModal">
                                İptal Et
                            </button>

                        </form>
                    }

                </div>
            </div>

            @if (ViewBag.CanAssign == true)
            {
                <div class="card mb-3">
                    <div class="card-header">
                        <strong>Destek Uzmanı Ata</strong>
                    </div>
                    <div class="card-body">

                        <form asp-action="AssignUser" method="post" novalidate>

                            <input type="hidden"
                                   name="ticketId"
                                   value="@Model.Id" />

                            <div class="mb-3">
                                <select name="userId" class="form-select">

                                    @foreach (var user in (List<SupportPanel.Models.User>)ViewBag.Users)
                                    {
                                        <option value="@user.Id"
                                                selected="@(user.Id == Model.AssignedUserId)">
                                            @user.FirstName @user.LastName
                                            @if (user.Id == (int)ViewBag.CurrentUserId)
                                            {
                                                <text> (Kendi Üzerime Al)</text>
                                            }
                                            else if (user.Role?.Name == RoleNames.ProductManager)
                                            {
                                                <text> (Ürün Yöneticisi)</text>
                                            }
                                        </option>
                                    }

                                </select>
                            </div>

                            <button class="btn btn-primary btn-sm"
                                    type="submit">
                                Ata
                            </button>

                        </form>

                    </div>
                </div>
            }

            @if (ViewBag.CanTransferToProductManager == true)
            {
                <div class="card mb-3">
                    <div class="card-header">
                        <strong>Ürün Yöneticisine Devret</strong>
                    </div>
                    <div class="card-body">
                        <form asp-action="TransferToProductManager" method="post">
                            <input type="hidden" name="ticketId" value="@Model.Id" />
                            <div class="mb-3">
                                <select name="productManagerId" class="form-select" required>
                                    @foreach (var manager in (List<SupportPanel.Models.User>)ViewBag.ProductManagers)
                                    {
                                        <option value="@manager.Id">@manager.FirstName @manager.LastName</option>
                                    }
                                </select>
                            </div>
                            <button class="btn btn-outline-primary w-100" type="submit">Devret</button>
                        </form>
                    </div>
                </div>
            }

            @if (slaTracking != null)
            {
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <strong>SLA Takibi</strong>
                        <span class="badge bg-light text-dark">
                            @(slaTracking.CalculationMethod == SlaCalculationMethod.WorkingHours
                                ? "Çalışma Saatleri"
                                : "7x24")
                        </span>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <div class="small text-muted mb-1">İlk Müdahale</div>
                            @if (!slaTracking.IsStarted)
                            {
                                <span id="slaResponseValue" class="fw-semibold text-muted">Desteğe yönlendirilmesi bekleniyor.</span>
                            }
                            else if (slaTracking.IsResponseStopped)
                            {
                                <span id="slaResponseValue" class="fw-semibold text-muted">Talep iptal edildiği için durduruldu.</span>
                            }
                            else if (slaTracking.IsResponseCompleted)
                            {
                                <span id="slaResponseValue" class="fw-semibold @(slaTracking.IsResponseBreached ? "text-danger" : "text-success")">
                                    @SlaDurationFormatter.FormatDuration(slaTracking.ResponseElapsed) içinde tamamlandı
                                </span>
                            }
                            else if (slaTracking.IsResponseBreached)
                            {
                                <span id="slaResponseValue" class="fw-semibold text-danger">
                                    @SlaDurationFormatter.FormatDuration(slaTracking.ResponseRemaining) gecikti
                                </span>
                            }
                            else
                            {
                                <span id="slaResponseValue" class="fw-semibold text-success">
                                    @SlaDurationFormatter.FormatDuration(slaTracking.ResponseRemaining) kaldı
                                </span>
                            }
                        </div>

                        <div>
                            <div class="small text-muted mb-1">Çözüm</div>
                            @if (!slaTracking.IsStarted)
                            {
                                <span id="slaResolutionValue" class="fw-semibold text-muted">Desteğe yönlendirilmesi bekleniyor.</span>
                            }
                            else if (slaTracking.IsResolutionStopped)
                            {
                                <span id="slaResolutionValue" class="fw-semibold text-muted">Talep iptal edildiği için durduruldu.</span>
                            }
                            else if (slaTracking.IsResolutionCompleted)
                            {
                                <span id="slaResolutionValue" class="fw-semibold @(slaTracking.IsResolutionBreached ? "text-danger" : "text-success")">
                                    @SlaDurationFormatter.FormatDuration(slaTracking.ResolutionElapsed) içinde tamamlandı
                                </span>
                            }
                            else if (slaTracking.IsResolutionBreached)
                            {
                                <span id="slaResolutionValue" class="fw-semibold text-danger">
                                    @SlaDurationFormatter.FormatDuration(slaTracking.ResolutionRemaining) gecikti
                                </span>
                            }
                            else
                            {
                                <span id="slaResolutionValue" class="fw-semibold text-success">
                                    @SlaDurationFormatter.FormatDuration(slaTracking.ResolutionRemaining) kaldı
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }

            <div class="card mb-3">
                <div class="card-header">
                    <strong>Hızlı Bilgi</strong>
                </div>
                <div class="card-body">

                    <dl class="row mb-0">

                        <dt class="col-6">Firma</dt>
                        <dd class="col-6">@Model.Tenant?.CompanyName</dd>

                        <dt class="col-6">Ürün</dt>
                        <dd class="col-6">@Model.Product?.Name</dd>

                        <dt class="col-6">Kategori</dt>
                        <dd class="col-6">@Model.Category?.Name</dd>

                        <dt class="col-6">SLA</dt>
                        <dd class="col-6">@Model.SlaLevel?.Name</dd>

                        <dt class="col-6">Oluşturan</dt>
                        <dd class="col-6">
                            @Model.CreatedByUser?.FirstName
                            @Model.CreatedByUser?.LastName
                        </dd>

                        <dt class="col-6">Oluşturulma Tarihi</dt>
                        <dd class="col-6">
                            @Model.CreatedDate.ToString("dd.MM.yyyy HH:mm")
                        </dd>

                    </dl>

                </div>
            </div>

        </div>

    </div>

</div>

@if (User.IsInRole(RoleNames.CompanyManager) && ViewBag.CanCompanyClose == true)
{
    <div class="modal fade" id="companyCloseModal" tabindex="-1"
         aria-labelledby="companyCloseModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title" id="companyCloseModalLabel">Talebi Kapat</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    @if (Model.Status == TicketStatus.New)
                    {
                        <span>Bu talep firma içinde çözüldü olarak işaretlenecek ve kapatılacaktır.</span>
                    }
                    else
                    {
                        <span>Çözülen talep onaylanarak kapatılacaktır.</span>
                    }
                    <strong class="d-block mt-2">Kapatıldıktan sonra yorum ve dosya eklenemez; talep sahibi veya firma yöneticisi yeniden açabilir.</strong>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-success" form="companyCloseForm">Talebi Kapat</button>
                </div>
            </div>
        </div>
    </div>
}

@if (ViewBag.CanReopen == true)
{
    <div class="modal fade" id="reopenTicketModal" tabindex="-1"
         aria-labelledby="reopenTicketModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title" id="reopenTicketModalLabel">Talebi Yeniden Aç</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    @if (Model.AssignedUserId.HasValue)
                    {
                        <p class="mb-0">Talep <strong>İnceleniyor</strong> durumuna alınacak ve atanan destek uzmanına geri dönecektir.</p>
                    }
                    else if (Model.SlaStartedDate.HasValue)
                    {
                        <p class="mb-0">Talep yüklenici <strong>destek havuzuna</strong> geri alınacaktır.</p>
                    }
                    else
                    {
                        <p class="mb-0">Talep firma incelemesi için <strong>Yeni</strong> durumuna alınacaktır.</p>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-primary" form="reopenTicketForm">Yeniden Aç</button>
                </div>
            </div>
        </div>
    </div>
}

@if (ViewBag.CanCancel == true)
{
    <div class="modal fade" id="cancelTicketModal" tabindex="-1"
         aria-labelledby="cancelTicketModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header">
                    <h5 class="modal-title" id="cancelTicketModalLabel">Talebi İptal Et</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">Bu talep iptal edilecek ve üzerinde yeni işlem yapılamayacak.</p>
                    <strong class="text-danger">Bu işlem geri alınamaz.</strong>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" class="btn btn-danger" form="cancelTicketForm">Talebi İptal Et</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var allowed = ['.jpg', '.jpeg', '.png', '.gif', '.webp', '.pdf', '.doc', '.docx', '.xls', '.xlsx', '.txt', '.zip', '.log'];
            var input = document.getElementById('detailsFileInput');
            if (!input) return;
            input.addEventListener('change', function () {
                var file = input.files && input.files[0];
                if (!file) return;
                var ext = '.' + file.name.split('.').pop().toLowerCase();
                if (allowed.indexOf(ext) === -1) {
                    alert('Bu dosya türü yüklenemez.');
                    input.value = '';
                    return;
                }
                if (file.size > 20 * 1024 * 1024) {
                    alert('Dosya boyutu en fazla 20 MB olabilir.');
                    input.value = '';
                }
            });
        })();
    </script>
    @if (slaTracking != null)
    {
        <script>
            (function () {
                var responseElement = document.getElementById('slaResponseValue');
                var resolutionElement = document.getElementById('slaResolutionValue');
                var trackingUrl = '@Url.Action("SlaTracking", "Ticket", new { id = Model.Id })';
                var state = null;

                if (!responseElement || !resolutionElement) return;

                function formatDuration(totalSeconds) {
                    var seconds = Math.max(0, Math.floor(Math.abs(totalSeconds)));
                    var days = Math.floor(seconds / 86400);
                    seconds %= 86400;
                    var hours = Math.floor(seconds / 3600);
                    seconds %= 3600;
                    var minutes = Math.floor(seconds / 60);
                    seconds %= 60;
                    var parts = [];

                    if (days) parts.push(days + ' gün');
                    if (hours) parts.push(hours + ' saat');
                    if (minutes) parts.push(minutes + ' dakika');
                    if (seconds || parts.length === 0) parts.push(seconds + ' saniye');
                    return parts.join(' ');
                }

                function renderItem(element, item) {
                    element.classList.remove('text-success', 'text-danger', 'text-muted');

                    if (!item.isStarted) {
                        element.classList.add('text-muted');
                        element.textContent = 'Desteğe yönlendirilmesi bekleniyor.';
                    } else if (item.isStopped) {
                        element.classList.add('text-muted');
                        element.textContent = 'Talep iptal edildiği için durduruldu.';
                    } else if (item.isCompleted) {
                        element.classList.add(item.isBreached ? 'text-danger' : 'text-success');
                        element.textContent = formatDuration(item.elapsedSeconds) + ' içinde tamamlandı';
                    } else if (item.remainingSeconds < 0 || item.isBreached) {
                        element.classList.add('text-danger');
                        element.textContent = formatDuration(item.remainingSeconds) + ' gecikti';
                    } else {
                        element.classList.add('text-success');
                        element.textContent = formatDuration(item.remainingSeconds) + ' kaldı';
                    }
                }

                function render() {
                    if (!state) return;
                    renderItem(responseElement, state.response);
                    renderItem(resolutionElement, state.resolution);
                }

                function tickItem(item) {
                    if (!item.shouldTick || item.isCompleted || item.isStopped) return;
                    item.remainingSeconds -= 1;
                    item.elapsedSeconds += 1;
                    item.isBreached = item.remainingSeconds < 0;
                }

                function tick() {
                    if (!state || document.hidden) return;
                    tickItem(state.response);
                    tickItem(state.resolution);
                    render();
                }

                async function synchronize() {
                    try {
                        var response = await fetch(trackingUrl, {
                            headers: { 'Accept': 'application/json' },
                            cache: 'no-store'
                        });
                        if (!response.ok) return;
                        state = await response.json();
                        render();
                    } catch (_) {
                        // Geçici bağlantı sorununda sayaç son bilinen değerle çalışmaya devam eder.
                    }
                }

                synchronize();
                window.setInterval(tick, 1000);
                window.setInterval(synchronize, 60000);
                document.addEventListener('visibilitychange', function () {
                    if (!document.hidden) synchronize();
                });
            })();
        </script>
    }
}
