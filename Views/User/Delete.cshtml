@model SupportPanel.Models.User

<h2 class="page-title">Kullanıcıyı Pasifleştir</h2>

<div class="card">
    <div class="card-header">
        <h3 class="mb-0">Kullanıcıyı Pasifleştir</h3>
    </div>
    <div class="card-body">
        <div class="alert alert-warning">
            Bu kullanıcı pasifleştirilecek; geçmiş kayıtları silinmeyecektir. Destek ekibi üyesiyse açık talepleri destek havuzuna aktarılır ve ürün sorumlulukları serbest bırakılır.
        </div>

        <dl class="row">
            <dt class="col-sm-3">Ad</dt>
            <dd class="col-sm-9">@Model.FirstName</dd>

            <dt class="col-sm-3">Soyad</dt>
            <dd class="col-sm-9">@Model.LastName</dd>

            <dt class="col-sm-3">Kullanıcı Adı</dt>
            <dd class="col-sm-9">@Model.Username</dd>

            <dt class="col-sm-3">E-posta</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            @if (Model.Tenant != null)
            {
                <dt class="col-sm-3">Firma</dt>
                <dd class="col-sm-9">@Model.Tenant.CompanyName</dd>
            }

            @if (Model.Role != null)
            {
                <dt class="col-sm-3">Rol</dt>
                <dd class="col-sm-9">@Model.Role.Name</dd>
            }
        </dl>
    </div>
    <div class="card-footer">
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline" novalidate>
            <button type="submit" class="btn btn-danger">Pasifleştir</button>
        </form>
        <a asp-action="Index" class="btn btn-light">Vazgeç</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
