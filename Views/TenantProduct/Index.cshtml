@model IEnumerable<SupportPanel.Models.TenantProduct>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title mb-0">Firma-Ürün Eşleştirmeleri</h2>
    <a asp-action="Create" class="btn btn-primary">Yeni Eşleştirme</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info border-0 bg-white text-center">
        Kayıt bulunamadı.
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Firma</th>
                        <th>Ürün</th>
                        <th>Atanma Tarihi</th>
                        <th>Aktif</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Tenant?.CompanyName</td>
                            <td>@item.Product?.Name</td>
                            <td>@item.AssignedDate.ToString("dd.MM.yyyy")</td>
                            <td>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                @if (item.Tenant?.IsActive != true)
                                {
                                    <span class="badge bg-warning text-dark">Firma Pasif</span>
                                }
                                else if (item.Product?.IsActive != true)
                                {
                                    <span class="badge bg-warning text-dark">Ürün Pasif</span>
                                }
                                else if (item.IsActive)
                                {
                                    <span class="badge bg-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Pasif</span>
                                }

                                @if (item.IsActive)
                                {
                                    <form asp-action="Deactivate" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Pasif Yap</button>
                                    </form>
                                }
                                else if (item.Tenant?.IsActive == true && item.Product?.IsActive == true)
                                {
                                    <form asp-action="Reactivate" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-outline-success btn-sm">Aktif Yap</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted small">Aktifleştirilemez</span>
                                }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
