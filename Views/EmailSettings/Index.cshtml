@model SupportPanel.Models.ViewModels.EmailSettingsViewModel
@{
    ViewData["Title"] = "SMTP Ayarları";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title">SMTP Ayarları</h2>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="card shadow-sm mb-4">
    <div class="card-header fw-semibold text-primary">SMTP Bağlantı Ayarları</div>
    <div class="card-body">
        <form asp-action="Save" method="post" autocomplete="off">
            <input asp-for="HasSavedPassword" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger fw-semibold small mb-3"></div>

            <div class="form-check form-switch mb-4">
                <input asp-for="Enabled" class="form-check-input" />
                <label asp-for="Enabled" class="form-check-label fw-semibold">E-posta gönderimini etkinleştir</label>
            </div>

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Host" class="form-label"></label>
                    <input asp-for="Host" class="form-control" placeholder="smtp.gmail.com" />
                    <span asp-validation-for="Host" class="text-danger fw-semibold small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Port" class="form-label"></label>
                    <input asp-for="Port" class="form-control" />
                    <span asp-validation-for="Port" class="text-danger fw-semibold small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Username" class="form-label"></label>
                    <input asp-for="Username" class="form-control" autocomplete="off" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password"
                           placeholder="@(Model.HasSavedPassword ? "Kayıtlı şifreyi korumak için boş bırakın" : "SMTP şifresini girin")" />
                    <span asp-validation-for="Password" class="text-danger fw-semibold small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="FromAddress" class="form-label"></label>
                    <input asp-for="FromAddress" class="form-control" placeholder="destek@firma.com" />
                    <span asp-validation-for="FromAddress" class="text-danger fw-semibold small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="FromName" class="form-label"></label>
                    <input asp-for="FromName" class="form-control" />
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="EnableSsl" class="form-check-input" />
                        <label asp-for="EnableSsl" class="form-check-label"></label>
                    </div>
                </div>
            </div>

            <div class="alert alert-light border mt-4 mb-3 small">
                Gmail için genellikle <strong>smtp.gmail.com / 587 / SSL-TLS açık</strong> kullanılır.
                Google hesabınızda iki adımlı doğrulamayı açıp normal şifre yerine uygulama parolası girmeniz gerekir.
            </div>

            <button type="submit" class="btn btn-primary">Ayarları Kaydet</button>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header fw-semibold text-primary">Bağlantıyı Test Et</div>
    <div class="card-body">
        <form asp-action="SendTest" method="post" class="row g-3 align-items-end">
            <div class="col-md-8">
                <label asp-for="TestRecipient" class="form-label"></label>
                <input name="testRecipient" type="email" class="form-control" placeholder="ornek@gmail.com" required />
                <div class="form-text">Test, en son kaydettiğiniz SMTP ayarlarıyla gönderilir.</div>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-outline-primary w-100">Test E-postası Gönder</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
