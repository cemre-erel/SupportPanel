@model List<SupportPanel.ViewModels.FirmReportViewModel>
@{
    ViewData["Title"] = "Firma Bazlı Talep Raporu";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title mb-0">Firma Bazlı Talep Raporu</h2>
    <a asp-action="Index" class="btn btn-light">Geri Dön</a>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Firma</th>
                            <th>Toplam Talep</th>
                            <th>Açık Talep</th>
                            <th>Çözülen Talep</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.CompanyName</td>
                                <td>
                                    <a asp-controller="Reports" asp-action="Index" asp-route-tenant="@item.CompanyName">
                                        @item.TotalCount
                                    </a>
                                </td>
                                <td>@item.OpenCount</td>
                                <td>@item.ResolvedCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted mb-0">Raporlanacak firma bulunmuyor.</p>
        }
    </div>
</div>
