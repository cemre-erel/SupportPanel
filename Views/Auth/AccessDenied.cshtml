@{
    ViewData["Title"] = "Erişim Engellendi";
}

<div class="card mx-auto mt-5" style="max-width: 420px;">
    <div class="card-body p-4 text-center">
        <h4 class="page-title mb-3">Erişim Engellendi</h4>
        <p class="text-muted mb-4">Bu sayfayı görüntüleme yetkiniz bulunmuyor.</p>
        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Ana Sayfaya Dön</a>
            <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="btn btn-outline-secondary">Çıkış Yap</button>
            </form>
        </div>
    </div>
</div>
