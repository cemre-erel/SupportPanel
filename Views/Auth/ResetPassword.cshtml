@model SupportPanel.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Şifre Sıfırla";
}

<div class="card mx-auto mt-5" style="max-width: 420px;">
    <div class="card-body p-4">
        <h4 class="page-title mb-4">Şifre Sıfırla</h4>

        @if (ViewBag.InvalidToken == true)
        {
            <div class="alert alert-danger">
                Bu şifre sıfırlama bağlantısının süresi dolmuş, geçersiz ya da daha önce
                kullanılmış. Her bağlantı yalnızca bir kez ve sınırlı bir süre için geçerlidir.
            </div>
            <a asp-controller="Auth" asp-action="ForgotPassword" class="btn btn-primary w-100">
                Yeni bağlantı iste
            </a>
        }
        else
        {
            <form asp-controller="Auth" asp-action="ResetPassword" method="post" novalidate>
                <input type="hidden" asp-for="Token" />

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" autofocus />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
                </div>

                <button type="submit" class="btn btn-primary w-100">Şifreyi Güncelle</button>
            </form>
        }
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}