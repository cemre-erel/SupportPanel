@model SupportPanel.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Şifremi Unuttum";
}

<div class="card mx-auto mt-5" style="max-width: 420px;">
    <div class="card-body p-4">
        <h4 class="page-title mb-4">Şifremi Unuttum</h4>

        @if (ViewBag.Submitted == true)
        {
            <div class="alert alert-success">
                Girdiğiniz e-posta adresine kayıtlı bir hesap varsa, şifre sıfırlama bağlantısı
                gönderildi. Lütfen gelen kutunuzu (ve spam klasörünü) kontrol edin.
            </div>
            <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-secondary w-100">Giriş sayfasına dön</a>
        }
        else
        {
            <p class="text-muted mb-3">
                Hesabınıza ait e-posta adresini girin, size şifrenizi sıfırlamanız için bir
                bağlantı gönderelim.
            </p>

            <form asp-controller="Auth" asp-action="ForgotPassword" method="post" novalidate>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" autofocus />
                    <span asp-validation-for="Email" class="text-danger"></span>
                    <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
                </div>

                <button type="submit" class="btn btn-primary w-100">Sıfırlama Bağlantısı Gönder</button>
                <a asp-controller="Auth" asp-action="Login" class="btn btn-link w-100 mt-2">Giriş sayfasına dön</a>
            </form>
        }
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}