@model List<SupportPanel.Models.Category>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title">Kategoriler</h2>
    <a asp-action="Create" class="btn btn-primary">
        Yeni Kategori
    </a>
</div>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Id</th>
            <th>Ad</th>
            <th>Açıklama</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="4">
                    <div class="alert alert-info border-0 bg-white text-center mb-0">
                        Kayıt bulunamadı.
                    </div>
                </td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Description</td>
                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">
                            Düzenle
                        </a>
                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm">
                            Sil
                        </a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
