@model SupportPanel.Models.Category

<div class="card">
    <div class="card-header">
        <h2 class="page-title mb-0">Kategori Sil</h2>
    </div>
    <div class="card-body">
        <div class="alert alert-danger">
            Bu kategoriyi silmek istediğinize emin misiniz?
        </div>
        <dl class="row">
            <dt class="col-sm-2">Ad</dt>
            <dd class="col-sm-10">@Model.Name</dd>
            <dt class="col-sm-2">Açıklama</dt>
            <dd class="col-sm-10">@Model.Description</dd>
        </dl>
    </div>
    <div class="card-footer">
        <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post" class="d-inline" novalidate>
            <button type="submit" class="btn btn-danger">Sil</button>
        </form>
        <a asp-action="Index" class="btn btn-light">Vazgeç</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
