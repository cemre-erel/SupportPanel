@model IEnumerable<SupportPanel.Models.Product>

@using SupportPanel.Constants

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="page-title mb-0">Ürünler</h2>
    @if (User.IsInRole(RoleNames.SystemAdmin))
    {
        <a asp-action="Create" class="btn btn-primary">Yeni Ürün</a>
    }
</div>

<div class="card">
    <div class="card-body">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="text-uppercase text-muted small">Ürün Adı</th>
                    <th class="text-uppercase text-muted small">Açıklama</th>
                    <th class="text-uppercase text-muted small">Versiyon</th>
                    <th class="text-uppercase text-muted small">Aktif</th>
                    <th class="text-uppercase text-muted small">Oluşturulma</th>
                    <th class="text-uppercase text-muted small">İşlemler</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.Description</td>
                        <td>@item.Version</td>

                        <td>
                            @(item.IsActive ? "Evet" : "Hayır")
                        </td>

                        <td>
                            @item.CreatedDate.ToString("dd.MM.yyyy")
                        </td>

                        <td>
                            @if (User.IsInRole(RoleNames.SystemAdmin))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Düzenle</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">Sil</a>
                            }
                            else
                            {
                                <span class="text-muted small">Salt okunur</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
